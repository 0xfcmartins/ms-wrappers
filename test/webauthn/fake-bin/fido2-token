#!/bin/sh
# Stand-in for fido2-token: one key, one resident credential for login.microsoft.com, PIN 1234.
if [ "$1" = "-L" ] && [ "$#" -eq 1 ]; then
    echo "/dev/hidraw9: vendor=0x1050, product=0x0407 (Yubico YubiKey OTP+FIDO+CCID)"
    exit 0
fi
if [ "$1" = "-L" ] && [ "$2" = "-k" ]; then
    read -r pin
    [ "$pin" = "1234" ] || { echo "fido2-token: fido_credman_get_dev_rk: FIDO_ERR_PIN_INVALID" >&2; exit 1; }
    [ "$3" = "login.microsoft.com" ] || { echo "fido2-token: fido_credman_get_dev_rk: FIDO_ERR_NO_CREDENTIALS" >&2; exit 1; }
    echo "00: q83vASNFZ4k= user@example.com dXNlci1oYW5kbGU= es256 uvopt+id"
    exit 0
fi
exit 1
